DATABASE_URL=postgresql://eval:eval_dev@localhost:5432/eval_dev
REDIS_URL=redis://localhost:6379
API_PORT=3001
# Bind address: loopback for local development; containers must set 0.0.0.0
# (the API Dockerfile does this automatically).
#API_HOST=127.0.0.1
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-in-production
SESSION_MAX_AGE_HOURS=24
# Stable secret for pseudonymous identifiers; generate a random value locally.
# Do not change it between imports of the same dataset.
PSEUDONYM_SECRET=

# ── LLM judges ────────────────────────────────────────────────────────────────
# Leave everything unset for deterministic fake judges (EVALUATION_MODE=demo
# required to launch legacy pipeline runs without a real model).
GEMINI_MODEL=gemini-2.5-flash

# Option A: Vertex AI via Application Default Credentials (service account on
# Cloud Run; locally via `gcloud auth application-default login`).
#GEMINI_USE_VERTEX=true
#GOOGLE_CLOUD_PROJECT=yalo-eval-wa
#GOOGLE_CLOUD_LOCATION=global

# Option B: Vertex AI via your interactive gcloud session (LOCAL ONLY —
# uses `gcloud auth print-access-token`; never deploy this mode).
GOOGLE_AUTH_MODE=gcloud
GOOGLE_CLOUD_PROJECT=yalo-eval-wa

# Option C: public Gemini API key.
#GEMINI_API_KEY=

# ── BigQuery import (workspace) ───────────────────────────────────────────────
# Billing project for BigQuery jobs; defaults to GOOGLE_CLOUD_PROJECT.
#BIGQUERY_PROJECT=yalo-eval-wa
